<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F14">

    <TextView
        android:id="@+id/appLockTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Wault.io"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="100dp"/>

    <TextView
        android:id="@+id/appLockSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter your 4-digit PIN"
        android:textColor="#7E8999"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@id/appLockTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"/>

    <EditText
        android:id="@+id/pinInput"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:hint="••••"
        android:inputType="numberPassword"
        android:maxLength="4"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textColorHint="#657080"
        android:textSize="20sp"
        android:background="@drawable/bg_input"
        app:layout_constraintTop_toBottomOf="@id/appLockSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="60dp"
        android:layout_marginTop="30dp"/>

    <Button
        android:id="@+id/unlockButton"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="Unlock"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/pinInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="60dp"
        android:layout_marginTop="20dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>